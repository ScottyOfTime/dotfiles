// fastfetch's default layout, recoloured: yellow logo, keys and title
// (ghostty's ayu yellow). ANSI colour names follow the terminal theme, so
// darkman needs nothing here.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "color": { "1": "yellow", "2": "yellow" }
    },
    "display": {
        "color": { "keys": "yellow", "title": "yellow" }
    }
}
