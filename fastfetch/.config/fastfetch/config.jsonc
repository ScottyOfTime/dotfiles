// fastfetch's default output (modules from `fastfetch --gen-config`), recoloured:
// yellow logo, keys and title (ghostty's ayu yellow). ANSI colour names follow
// the terminal theme, so darkman needs nothing here.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "color": { "1": "yellow", "2": "yellow" }
    },
    "display": {
        "color": { "keys": "yellow", "title": "yellow" }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
