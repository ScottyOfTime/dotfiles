// short and flat: small arch logo, yellow keys (ghostty's ayu yellow) and a
// colour strip. ANSI colour names follow the terminal theme, so darkman needs
// nothing here.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": { "1": "yellow", "2": "yellow" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "yellow", "title": "yellow" },
        "key": { "width": 8 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "os", "key": "os", "format": "{name}" },
        { "type": "kernel", "key": "kernel", "format": "{release}" },
        { "type": "wm", "key": "wm", "format": "{pretty-name}" },
        { "type": "terminal", "key": "term", "format": "{pretty-name}" },
        { "type": "shell", "key": "shell", "format": "{pretty-name}" },
        { "type": "packages", "key": "pkgs", "format": "{all}" },
        { "type": "memory", "key": "mem", "format": "{used} / {total}" },
        { "type": "uptime", "key": "up" },
        "break",
        { "type": "colors", "symbol": "block" }
    ]
}
