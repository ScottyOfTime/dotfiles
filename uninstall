#!/bin/sh
# ./uninstall [-y]   undo ./install: unlink base and every theme, move the
#                    files install set aside (<file>.bak) back, delete the
#                    fonts and cursors the themes generated, and restore the
#                    desktop settings (./desktop-settings restore)
cd "$(dirname "$(readlink -f "$0")")" || exit 1
. ./links.sh
yes=; force=
for a; do case $a in -y) yes=1 ;; --force) force=1 ;; esac; done

# Hyprland reloads its config as it disappears, and then has none: it
# segfaults and the session goes with it
if pgrep -x Hyprland >/dev/null && [ -z "$force" ]; then
    echo "Hyprland is running on this config: run ./uninstall from a TTY or another desktop (or --force)" >&2
    exit 1
fi
if [ -z "$yes" ]; then
    printf 'unlink the dotfiles and restore the desktop settings? [y/N] '
    read -r a; case $a in y|Y|yes) ;; *) exit 1 ;; esac
fi

~/.config/hypr-theme/stop 2>/dev/null
command -v gnome-extensions >/dev/null && gnome-extensions disable dotfiles-look@scotty 2>/dev/null

# what theme.sh rendered from a .tmpl into a real folder (~/.config/yazi)
# outlives the link; ones inside a folded link go with it
for t in themes/*/; do
    t=${t#themes/}; t=${t%/}
    for pkg in $(packages "$t"); do
        (cd "themes/$t/$pkg" && find . -name '*.tmpl') | while read -r f; do
            out=$HOME/${f#./}; out=${out%.tmpl}
            [ -f "$out" ] || continue
            case $(readlink -f "$out") in "$PWD"/*) continue ;; esac
            rm "$out" && echo "removed ~/${out#$HOME/} (rendered by the theme)"
        done
    done
done

# every theme, not just the current one: an interrupted switch can leave two
for t in themes/*/; do
    t=${t#themes/}; t=${t%/}
    stow -D -d "themes/$t" -t "$HOME" $(packages "$t") 2>/dev/null
done
stow -D -d base -t "$HOME" $(ls base) 2>/dev/null
echo "unlinked base and the themes"

# install moved what was in the way to <path>.bak; a later install moving
# something again pushed that to .bak.~1~ (mv --backup=numbered), so the
# original is .bak.~1~ when there is one
{ for p in $(ls base); do echo "base/$p"; done
  for t in themes/*/; do t=${t#themes/}; t=${t%/}; packages "$t" | sed "s|^|themes/$t/|"; done
} | while read -r pkg; do
        (cd "$pkg" && find . -mindepth 1 -print) | while read -r f; do
            f=${f#./}
            orig=$HOME/$f.bak; [ -e "$orig.~1~" ] && orig=$orig.~1~
            if [ -e "$orig" ] && [ ! -e "$HOME/$f" ] && [ ! -L "$HOME/$f" ]; then
                mv "$orig" "$HOME/$f" && echo "restored ~/$f"
            fi
        done
done

# generated by the themes, outside the repo
rm -rf ~/.local/share/fonts/terminess-outline && fc-cache -f >/dev/null 2>&1
for d in ~/.local/share/icons/*_2x; do
    # cursor-2x's copies keep the untinted originals in original/
    [ -d "$d/original" ] && rm -rf "$d" && echo "removed the ${d##*/} cursor copy"
done
rmdir ~/.config/gtk-4.0 ~/.local/share/gnome-shell/extensions ~/.config/yazi 2>/dev/null

./desktop-settings restore && echo "restored the desktop settings"
rm -f "$state/dotfiles-theme" "$skipfile" "$state/theme-mode" "$state/oldschool-font"
pkill -SIGUSR2 -x ghostty
echo "done: log out and back in for GNOME to drop the extension; ./install puts it all back"
