# zine light: cream paper with muted riso-print inks
# hex without '#'; darkman renders each app's *.tmpl from this
mode=light
bg=f1e6d6
panel=e8dbc7
surface=dccdb6
fg=2a2420
dim=8a7d6c
# outlines and hard shadows
ink=2a2420
# the riso inks; accent is the softened zine orange
accent=c0703f
mustard=c79a3c
sage=6f8c58
teal=4a8a82
blue=5a7bab
rose=b5677a
plum=82659f
red=b54a3c
cursor=Bibata-Modern-Classic
# libadwaita accent, the closest named one to accent above
gtk_accent=orange
