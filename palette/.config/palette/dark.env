# zine dark: warm ink page with muted riso-print inks
# hex without '#'; darkman renders each app's *.tmpl from this
mode=dark
bg=1f1c19
panel=2a2622
surface=36312c
fg=ecdfcc
dim=8a7f70
# outlines and hard shadows
ink=0b0a09
# the riso inks; accent is the softened zine orange
accent=d68a5c
mustard=dbb56e
sage=9fb68a
teal=82b3ab
blue=8aa7cf
rose=d39aa6
plum=ab8fc6
red=d9705f
cursor=Bibata-Modern-Classic
# libadwaita accent, the closest named one to accent above
gtk_accent=orange
