# Ayu dark, shared by every themed app (hex without '#')
# darkman renders each app's *.tmpl from this; ghostty and nvim use their own
# Ayu themes, and ghostty's tabs.css hardcodes the accent.
mode=dark
bg=0b0e14
panel=0d1017
shadow=06070a
fg=bfbdb6
dim=646b73
accent=e6b450
blue=59c2ff
green=aad94c
purple=d2a6ff
red=f07178
