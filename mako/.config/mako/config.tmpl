# generated by darkman from ~/.config/palette/${mode}.env, edit the .tmpl
# zine: notes on tape-coloured paper with an ink border, like the drop cap box
font=JetBrains Mono Bold 11
background-color=#${tape}
text-color=#${ink}
border-color=#${ink}
progress-color=over #${accent}
border-size=3
border-radius=0
padding=12
margin=14
width=380
default-timeout=5000
anchor=top-right

[urgency=low]
border-color=#${dim}

[urgency=critical]
background-color=#${accent}
text-color=#${cream}
border-color=#${brown}
default-timeout=0
