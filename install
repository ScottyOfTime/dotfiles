#!/bin/sh
# ./install [-y] [theme]   first run on a new machine, or rerun to change
#                          what's linked: menus pick the theme and what to
#                          link (-y, or no terminal: no menus, the last
#                          choices), real files in the way go to <file>.bak,
#                          then it builds and switches to the theme
cd "$(dirname "$(readlink -f "$0")")" || exit 1
base="bash fastfetch fontconfig ghostty hypr nvim vim yazi"
. ./links.sh
ask=1
[ "$1" = -y ] && { ask=; shift; }
[ -t 0 ] && [ -t 2 ] || ask=
current=$(cat "$state/dotfiles-theme" 2>/dev/null)
theme=$1
if [ -z "$theme" ] && [ -n "$ask" ]; then
    set --
    for t in $current $(ls themes | grep -vx "${current:-.}"); do set -- "$@" "$t" "$(theme_about "$t")"; done
    theme=$(choose_one "Theme" "$@") || exit 1
fi
theme=${theme:-${current:-zine}}
[ -d "themes/$theme" ] || { echo "no theme '$theme'" >&2; exit 1; }

# offer what this machine has an app for; what's left unticked goes in
# dotfiles-skip, which ./theme honours too
if [ -n "$ask" ]; then
    set -- ; absent=
    for p in $base; do
        if has_app "$p"; then
            set -- "$@" "base/$p" "$(about "base/$p")" "$(skipped "base/$p" && echo OFF || echo ON)"
        else absent="$absent $p"; fi
    done
    for p in $(packages "$theme"); do
        required "$p" && continue
        if has_app "$p"; then
            set -- "$@" "theme/$p" "$(about "theme/$p")" "$(skipped "theme/$p" && echo OFF || echo ON)"
        else absent="$absent $p"; fi
    done
    offered=$(printf '%s\n' "$@" | awk 'NR % 3 == 1' | tr '\n' ' ')
    note=; [ -n "$absent" ] && note=" (not offered, their app isn't installed:$absent)"
    chosen=$(choose "Link what?$note" "$@") || exit 1
    chosen=" $(echo $chosen) "
    mkdir -p "$state"
    {
        # earlier skips of packages not offered now stay
        [ -f "$skipfile" ] && while read -r k; do
            case " $offered " in *" $k "*) ;; *) echo "$k" ;; esac
        done < "$skipfile"
        for k in $offered; do case $chosen in *" $k "*) ;; *) echo "$k" ;; esac; done
    } > "$skipfile.new" && mv "$skipfile.new" "$skipfile"
fi

# stow aborts everything on one conflict, so a fresh machine's default
# .bashrc alone leaves hyprland with no config (it then segfaults). The
# wording differs by version: 2.4 (Arch) says "cannot stow … over existing
# [non-]directory target X", 2.3 (Debian, Ubuntu) "existing target is
# neither a link nor a directory: X"
clear_way() {
    stow -n -v -d "$1" -t "$HOME" $2 2>&1 | sed -n \
        -e 's/.* over existing target \(.*\) since .*/\1/p' \
        -e 's/.* over existing \(non-\)*directory target //p' \
        -e 's/.*existing target is neither a link nor a directory: //p' \
        -e 's/.*existing target is not owned by stow: //p' |
    while read -r f; do
        # another theme's links into this repo: ./theme unstows those itself
        case $(readlink -f "$HOME/$f") in "$PWD"/*) continue ;; esac
        mv --backup=numbered "$HOME/$f" "$HOME/$f.bak" && echo "moved ~/$f to ~/$f.bak"
    done
}

# report, don't install: pkglist/aur-pkgslist are the shared set, the
# theme's packages.txt what its look needs (first word of each line)
names() { awk '!/^#/ && NF {print $1}' "$@"; }
if command -v pacman >/dev/null; then
    need=$(names pkglist.txt "themes/$theme/packages.txt" | xargs pacman -T 2>/dev/null)
    aur=$(names aur-pkgslist.txt | xargs pacman -T 2>/dev/null)
    if [ -n "$need$aur" ]; then
        echo "missing packages (install them, then rerun if anything breaks):"
        [ -n "$need" ] && echo "  sudo pacman -S --needed" $need
        [ -n "$aur" ] && echo "  yay -S --needed" $aur
    fi
elif command -v dpkg-query >/dev/null; then
    # the lists are Arch names; debian-pkgs.txt renames the ones that differ
    need= byhand=
    for p in $(names pkglist.txt aur-pkgslist.txt "themes/$theme/packages.txt" |
               awk 'NR == FNR { if (!/^#/ && NF) map[$1] = $2; next }
                    { p = ($1 in map) ? map[$1] ":" $1 : $1; k = p; sub(/:.*/, "", k) }
                    k == "-" || k == "!" || !seen[k]++ { print p }' debian-pkgs.txt -); do
        case $p in
            -:*) continue ;;
            !:*) byhand="$byhand ${p#!:}"; continue ;;
        esac
        p=${p%%:*}
        dpkg-query -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null | grep -q '^ii' && continue
        if apt-cache show "$p" >/dev/null 2>&1; then need="$need $p"; else byhand="$byhand $p"; fi
    done
    if [ -n "$need$byhand" ]; then
        echo "missing packages (install them, then rerun if anything breaks):"
        [ -n "$need" ] && echo "  sudo apt install$need"
        [ -n "$byhand" ] && echo "  not in apt, see docs/setup.md:$byhand"
    fi
fi
if ! command -v Hyprland >/dev/null; then
    echo "warning: no Hyprland (desktop: ${XDG_CURRENT_DESKTOP:-unknown}): linking only the configs of apps that are installed"
elif ! hypr_ok; then
    echo "warning: $(Hyprland --version | sed 's/ built.*//;q') is too old: the config needs 0.56 or newer (docs/setup.md), so it isn't linked"
fi

# the first install on this machine: remember the desktop settings before
# anything changes them, for ./uninstall
[ -n "$current" ] || ./desktop-settings save

# base and the theme both put files in it: a folded symlink to one of them
# would make stowing the other fail
mkdir -p ~/.config/yazi
pick base $base
clear_way base "$use"
[ -n "$use" ] && { stow -d base -t "$HOME" $use || exit 1; }
# yazi as the folder handler only for the Hyprland desktop; GNOME keeps its own
case " $use " in *" yazi "*) hypr_ok && xdg-mime default com.scotty.files.desktop inode/directory ;; esac
# ./theme links (and reports on) the theme's; only clear the way here
use=
for p in $(packages "$theme"); do
    wanted "themes/$theme" "$p" && use="$use $p"
done
clear_way "themes/$theme" "$use"
[ -x "themes/$theme/colorscheme/build.py" ] && "themes/$theme/colorscheme/build.py"
./theme "$theme"
# darkman is what reruns theme.sh when the mode changes; apt installs its
# user service without starting it
if command -v darkman >/dev/null && command -v systemctl >/dev/null &&
    ! systemctl --user is-active -q darkman.service 2>/dev/null; then
    echo "darkman isn't running, so modes won't switch: systemctl --user enable --now darkman.service"
fi
