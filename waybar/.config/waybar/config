{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "network", "battery"],

    "clock": {
        "format": "{:%H:%M  %d/%m/%Y}",
        "tooltip": false
    },
    "mpris": {
        "player": "spotify",
        "format": "{status_icon} {artist} - {title}",
        "status-icons": {
            "playing": "",
            "paused": "",
            "stopped": ""
        },
        "max-length": 40,
        "tooltip-format": "{artist} - {title}"
    },
    "battery": {
        "format": "BAT {capacity}%"
    },
    "network": {
        "format-wifi": "{essid} {bandwidthDownBits} {signalStrength}%",
        "format-ethernet": "ETH {bandwidthDownBits}",
        "format-disconnected": "No Network",
        "interval": 2
    }
}
