{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["network", "battery"],

    "clock": {
        "format": "{:%H:%M  %d/%m/%Y}",
        "tooltip": false
    },
    "battery": {
        "format": "BAT {capacity}%"
    },
    "network": {
        "format-wifi": "{essid} {bandwidthDownBits} {signalStrength}%",
        "format-disconnected": "No Network",
        "interval": 2
    }
}
