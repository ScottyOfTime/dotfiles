{
    "layer": "top",
    "position": "top",
    "height": 40,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "wireplumber",
        "cpu",
        "memory",
        "network",
        "battery"
    ],
    "clock": {
        "format": "{:%H:%M  %a %d %b}",
        "tooltip": false
    },
    "mpris": {
        "player": "spotify",
        "format": "{artist} - {title}",
        "max-length": 40,
        "tooltip-format": "{artist} - {title}",
        "format-paused": "paused"
    },
    "battery": {
        "format": "bat {capacity}%"
    },
    "network": {
        "format-wifi": "{essid} {bandwidthDownBits}",
        "format-ethernet": "eth {bandwidthDownBits}",
        "format-disconnected": "offline",
        "interval": 2
    },
    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },
    "wireplumber": {
        "format": "vol {volume}%",
        "format-muted": "muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "cpu": {
        "format": "cpu {usage}%",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "memory": {
        "format": "mem {percentage}%",
        "interval": 5,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "hyprland/workspaces": {
        "tooltip": false
    },
    "margin-top": 10,
    "margin-left": 16,
    "margin-right": 16,
    "spacing": 4
}
