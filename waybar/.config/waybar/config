{
    "layer": "top",
    "position": "top",
    "height": 40,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "mpris",
        "wireplumber",
        "cpu",
        "memory",
        "network",
        "battery"
    ],
    "clock": {
        "format": "<span font_family='Noto Serif Display' weight='900' style='italic' size='130%'>{0:%H}</span>:{0:%M}  <span font_family='Cloister Black' size='125%'>{0:%a}</span> {0:%d %b}",
        "tooltip": false
    },
    "mpris": {
        "player": "spotify",
        "format": "<span font_family='EB Garamond' style='italic' size='145%'>♪</span> {artist} - {title}",
        "max-length": 40,
        "tooltip-format": "{artist} - {title}",
        "format-paused": "<span font_family='EB Garamond' style='italic' size='145%'>P</span>aused"
    },
    "battery": {
        "format": "<span font_family='EB Garamond' style='italic' size='145%'>B</span>at {capacity}%"
    },
    "network": {
        "format-wifi": "<span font_family='EB Garamond' style='italic' size='145%'>W</span>ifi {bandwidthDownBits}",
        "format-ethernet": "<span font_family='EB Garamond' style='italic' size='145%'>E</span>th {bandwidthDownBits}",
        "format-disconnected": "<span font_family='EB Garamond' style='italic' size='145%'>O</span>ffline",
        "interval": 2
    },
    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },
    "wireplumber": {
        "format": "<span font_family='EB Garamond' style='italic' size='145%'>V</span>ol {volume}%",
        "format-muted": "<span font_family='EB Garamond' style='italic' size='145%'>M</span>uted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "cpu": {
        "format": "<span font_family='EB Garamond' style='italic' size='145%'>C</span>pu {usage}%",
        "interval": 2,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "memory": {
        "format": "<span font_family='EB Garamond' style='italic' size='145%'>M</span>em {percentage}%",
        "interval": 5,
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    "hyprland/workspaces": {
        "tooltip": false
    },
    "margin-top": 10,
    "margin-left": 16,
    "margin-right": 16,
    "spacing": 4
}
