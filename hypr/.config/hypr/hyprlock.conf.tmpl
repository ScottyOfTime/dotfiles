# generated by darkman from ~/.config/palette/${mode}.env, edit the .tmpl
#
# just a password box: a rounded panel pill on the wallpaper
# (hyprlang treats # as a comment, so colours in markup are written ##)

general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 3, linear
    animation = fadeOut, 1, 3, linear
    animation = inputFieldDots, 1, 2, linear
}

background {
    monitor =
    path = ~/.cache/wallpaper/zine-${mode}.png
    color = rgb(${bg})
}

input-field {
    monitor =
    size = 420, 50
    outline_thickness = 2
    rounding = 12
    outer_color = rgb(${ink})
    inner_color = rgb(${panel})
    font_color = rgb(${accent})
    font_family = JetBrains Mono Bold
    check_color = rgb(${accent})
    fail_color = rgb(${red})
    capslock_color = rgb(${mustard})
    placeholder_text = <span foreground='##${dim}'>password</span>
    check_text = <span foreground='##${accent}'>checking...</span>
    fail_text = <span foreground='##${red}'>exit $ATTEMPTS: $PAMFAIL</span>
    # round dots as text, rather than drawn boxes
    dots_text_format = •
    dots_size = 0.4
    dots_spacing = 0.2
    dots_center = true
    fade_on_empty = false
    position = 0, 0
    halign = center
    valign = center
}
