# generated by darkman from ~/.config/palette/${mode}.env, edit the .tmpl
#
# flat lock screen in the same language as the desktop: a waybar-style strip
# with the accent underline, a big clock, and the password as a shell prompt

general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 3, linear
    animation = fadeOut, 1, 3, linear
    animation = inputFieldDots, 1, 2, linear
}

background {
    monitor =
    color = rgb(${bg})
}

# --- top strip, mirroring waybar ---------------------------------------------

# accent underline
shape {
    monitor =
    size = 100%, 2
    color = rgb(${accent})
    rounding = 0
    position = 0, -30
    halign = center
    valign = top
}

# "locked" as a solid accent block, like the active workspace
shape {
    monitor =
    size = 84, 30
    color = rgb(${accent})
    rounding = 0
    position = 10, 0
    halign = left
    valign = top
}

label {
    monitor =
    text = locked
    color = rgb(${bg})
    font_size = 13
    font_family = JetBrains Mono Bold
    position = 22, -6
    halign = left
    valign = top
    zindex = 1
}

label {
    monitor =
    text = cmd[update:60000] date +"%A %d/%m/%Y"
    color = rgb(${blue})
    font_size = 13
    font_family = JetBrains Mono
    position = 0, -6
    halign = center
    valign = top
}

# now playing, like waybar's mpris
label {
    monitor =
    text = cmd[update:2000] playerctl -p spotify metadata --format '{{artist}} - {{title}}' 2>/dev/null
    color = rgb(${purple})
    font_size = 13
    font_family = JetBrains Mono
    position = -20, -6
    halign = right
    valign = top
}

# --- clock ---------------------------------------------------------------------

label {
    monitor =
    text = cmd[update:1000] date +"%H<span foreground='#${accent}'>:</span>%M"
    color = rgb(${fg})
    font_size = 150
    font_family = JetBrains Mono ExtraBold
    position = 0, 150
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%B %Y" | tr '[:upper:]' '[:lower:]'
    color = rgb(${dim})
    font_size = 16
    font_family = JetBrains Mono
    position = 0, 20
    halign = center
    valign = center
}

# --- password, as a shell prompt -----------------------------------------------

label {
    monitor =
    text = cmd[update:0] echo "[<span foreground='#${blue}'>$USER</span>@<span foreground='#${purple}'>$(cat /etc/hostname)</span>:<span foreground='#${accent}'>~</span>] unlock"
    color = rgb(${fg})
    font_size = 14
    font_family = JetBrains Mono
    position = 0, -60
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 440, 46
    outline_thickness = 2
    rounding = 0
    outer_color = rgb(${dim})
    inner_color = rgb(${panel})
    font_color = rgb(${fg})
    font_family = JetBrains Mono
    check_color = rgb(${accent})
    fail_color = rgb(${red})
    capslock_color = rgb(${blue})
    placeholder_text = <span foreground='#${dim}'>password</span>
    check_text = <span foreground='#${accent}'>checking...</span>
    fail_text = <span foreground='#${red}'>exit $ATTEMPTS: $PAMFAIL</span>
    dots_size = 0.25
    dots_spacing = 0.4
    dots_rounding = 0
    dots_center = true
    fade_on_empty = false
    position = 0, -115
    halign = center
    valign = center
}

# hint
label {
    monitor =
    text = esc clears
    color = rgb(${dim})
    font_size = 11
    font_family = JetBrains Mono
    position = 0, -165
    halign = center
    valign = center
}
