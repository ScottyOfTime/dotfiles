# generated by darkman from ~/.config/palette/${mode}.env, edit the .tmpl
#
# just a password box on the terminal background
# (hyprlang treats # as a comment, so colours in markup are written ##)

general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 3, linear
    animation = fadeOut, 1, 3, linear
    animation = inputFieldDots, 1, 2, linear
}

background {
    monitor =
    color = rgb(${bg})
}

input-field {
    monitor =
    size = 440, 46
    outline_thickness = 2
    rounding = 0
    outer_color = rgb(${dim})
    inner_color = rgb(${panel})
    font_color = rgb(${fg})
    font_family = JetBrains Mono
    check_color = rgb(${accent})
    fail_color = rgb(${red})
    capslock_color = rgb(${blue})
    placeholder_text = <span foreground='##${dim}'>password</span>
    check_text = <span foreground='##${accent}'>checking...</span>
    fail_text = <span foreground='##${red}'>exit $ATTEMPTS: $PAMFAIL</span>
    dots_size = 0.25
    dots_spacing = 0.4
    dots_rounding = 0
    dots_center = true
    fade_on_empty = false
    position = 0, 0
    halign = center
    valign = center
}
