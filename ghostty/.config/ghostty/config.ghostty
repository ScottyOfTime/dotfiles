# selection
copy-on-select = false

# cursor
cursor-style = block
adjust-cursor-thickness = 2
cursor-style-blink = true
shell-integration-features = no-cursor, ssh-terminfo, ssh-env

# font
font-size = 13

# theme
theme = dark:Ayu,light:Ayu Light
unfocused-split-opacity = 0.9
# selection as a solid accent block, like the active tab and waybar workspace
selection-background = #e6b450
selection-foreground = #0b0e14

# window
window-decoration = none
window-padding-x = 0
window-padding-y = 0
window-theme = ghostty

# gtk
gtk-titlebar = false
gtk-tabs-location = bottom
gtk-wide-tabs = false
gtk-toolbar-style = flat
gtk-custom-css = tabs.css

# keybinds
keybind = ctrl+shift+r=prompt_tab_title
