# Ayu light, shared by every themed app (hex without '#')
# darkman renders each app's *.tmpl from this; ghostty and nvim use their own
# Ayu themes, and ghostty's tabs.css hardcodes the accent.
mode=light
bg=f8f9fa
panel=fcfcfc
shadow=d3d4d4
fg=5c6166
dim=adafb2
accent=e6b450
blue=399ee6
green=86b300
purple=a37acc
red=f07171
cursor=Bibata-Modern-Classic
# libadwaita accent, the closest named one to accent above
gtk_accent=yellow
