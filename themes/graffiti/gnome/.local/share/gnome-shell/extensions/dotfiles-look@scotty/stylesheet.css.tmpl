/* generated by darkman from ~/.config/palette/${mode}.env, edit the .tmpl */
/* graffiti on GNOME Shell: neutrals and the hot pink accent, sharp ink-outlined panels
   with hard ink shadows. */
/* loaded on top of the session's shell theme (Yaru on Ubuntu, Adwaita
   otherwise), so only what differs is set. Selectors are GNOME 46's. */

#panel {
    background-color: #${panel};
}
#panel .panel-button {
    color: #${fg};
    border-radius: 0;
}
#panel .panel-button:hover,
#panel .panel-button:focus {
    box-shadow: inset 0 0 0 100px #${surface};
}
#panel .panel-button:active,
#panel .panel-button:checked {
    box-shadow: inset 0 0 0 100px #${accent};
    color: #${ink};
}
#panel .workspace-dot {
    background-color: #${fg};
}

.popup-menu-content,
.candidate-popup-content,
.osd-window,
.modal-dialog,
.switcher-list,
.notification-banner {
    background-color: #${panel};
    color: #${fg};
    border-radius: 0;
    border: 2px solid #${ink};
    box-shadow: 4px 4px 0 #${ink};
}
.popup-menu-item {
    color: #${fg};
    border-radius: 0;
}
.popup-menu-item:hover,
.popup-menu-item:focus,
.popup-menu-item:active,
.popup-menu-item:checked,
.popup-menu-item.selected,
.switcher-list .item-box:selected {
    background-color: #${surface};
    color: #${fg};
}
.popup-separator-menu-item .popup-separator-menu-item-separator {
    background-color: #${ink};
}
.popup-inactive-menu-item {
    color: #${dim};
}

.quick-toggle,
.quick-menu-toggle .quick-toggle,
.quick-menu-toggle .quick-toggle-arrow,
.quick-settings .icon-button,
.quick-settings-system-item .icon-button,
.quick-toggle-menu,
.message,
.modal-dialog-button-box .button {
    background-color: #${surface};
    color: #${fg};
    border-radius: 0;
}
.quick-toggle:checked,
.quick-menu-toggle .quick-toggle:checked,
.quick-menu-toggle .quick-toggle-arrow:checked,
.quick-settings .icon-button:hover,
.quick-toggle:hover,
.modal-dialog-button-box .button:hover,
.modal-dialog-button-box .button:focus,
.calendar .calendar-today,
.calendar .calendar-today:hover,
.calendar .calendar-today:selected {
    background-color: #${accent};
    color: #${ink};
}
.calendar .calendar-day,
.calendar .calendar-weekday,
.calendar .calendar-month-header .pager-button,
.datemenu-today-button .date-label,
.events-button .events-title {
    color: #${fg};
}
.calendar .calendar-nonwork-day,
.calendar .calendar-other-month {
    color: #${dim};
}

.slider,
.level {
    -barlevel-active-background-color: #${accent};
    -barlevel-background-color: #${surface};
    -barlevel-overdrive-color: #${red};
    color: #${fg};
}

StEntry,
.search-entry {
    background-color: #${surface};
    color: #${fg};
    border-radius: 0;
}
StEntry:focus,
.search-entry:focus {
    box-shadow: inset 0 0 0 2px #${accent};
}

.dash-background,
#dashtodockContainer .dash-background {
    background-color: #${panel};
    border-radius: 0;
}

.modal-dialog .message-dialog-title,
.modal-dialog .message-dialog-description {
    color: #${fg};
}
.modal-dialog-button-box .button.destructive-action {
    background-color: #${red};
    color: #${ink};
}
