set -g status-style "bg=#${panel},fg=#${dim}"
set -g status-left "#[fg=#${fg}] #S "
set -g status-left-length 30
set -g status-right "#H "
set -g window-status-separator ""
set -g window-status-format " #I #W "
set -g window-status-current-format "#[bg=#${accent},fg=#${ink}] #I #W "
set -g window-status-activity-style "fg=#${fg}"
set -g window-status-bell-style "fg=#${red}"
set -g pane-border-style "fg=#${dim}"
set -g pane-active-border-style "fg=#${accent}"
set -g message-style "bg=#${accent},fg=#${ink}"
set -g message-command-style "bg=#${panel},fg=#${fg}"
set -g mode-style "bg=#${accent},fg=#${ink}"
set -g copy-mode-match-style "bg=#${surface},fg=#${fg}"
set -g copy-mode-current-match-style "bg=#${accent},fg=#${ink}"
set -g menu-style "bg=#${panel},fg=#${fg}"
set -g menu-selected-style "bg=#${accent},fg=#${ink}"
set -g menu-border-style "fg=#${dim}"
set -g popup-border-style "fg=#${dim}"
set -g clock-mode-colour "#${accent}"
set -g display-panes-colour "#${dim}"
set -g display-panes-active-colour "#${accent}"
