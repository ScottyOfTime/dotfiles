#!/bin/sh
# sudo ./uninstall-sddm: back to the login screen from before install-sddm
set -e
[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 1; }
[ -e /etc/sddm.conf.oldschool-bak ] && mv /etc/sddm.conf.oldschool-bak /etc/sddm.conf
rm -rf /usr/share/sddm/themes/oldschool
echo "restored: log out to see it"
