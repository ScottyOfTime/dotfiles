#!/bin/sh
# sudo ./install-boot: give GRUB and the Linux console the oldschool look.
# GRUB gets a theme built from the dark palette (amber Terminus, reverse
# video selection); the console (boot messages, ctrl+alt+fN) gets the amber
# palette and the kernel's built-in Terminus 16x32, both as kernel options
# (vt.default_*, fbcon=font:). Backs up /etc/default/grub once, as
# grub.oldschool-bak, and rebuilds grub.cfg. ./uninstall-boot undoes it.
set -e
[ "$(id -u)" = 0 ] || { echo "run with sudo" >&2; exit 1; }
here=$(dirname "$(readlink -f "$0")")
theme_dir=/boot/grub/themes/oldschool
font=$(fc-list "Terminess Nerd Font Mono:style=Regular" file | head -1 | cut -d: -f1)
[ -n "$font" ] || { echo "install ttf-terminus-nerd first" >&2; exit 1; }

set -a; . "$here/../palette/.config/palette/dark.env"; set +a

[ -e /etc/default/grub.oldschool-bak ] || cp -a /etc/default/grub /etc/default/grub.oldschool-bak

mkdir -p "$theme_dir"
vars="$(sed -n 's/^\([a-z_]*\)=.*/$\1/p' "$here/../palette/.config/palette/dark.env" | tr '\n' ' ')"
envsubst "$vars" < "$here/grub-theme.txt.tmpl" > "$theme_dir/theme.txt"
grub-mkfont -n "Oldschool Terminus" -s 32 -o "$theme_dir/terminus32.pf2" "$font"
# one-pixel PNGs GRUB stretches: the selection bar and the terminal's box
python3 - "$theme_dir" "$fg" "$bg" <<'PY'
import struct, sys, zlib
out, fg, bg = sys.argv[1:]
def png(path, hex):
    raw = b"\0" + bytes.fromhex(hex)
    chunk = lambda tag, data: struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data))
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0))
                + chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))
png(f"{out}/select_c.png", fg)
png(f"{out}/term_c.png", bg)
PY

# the console's 16 colours: 0 is its background, 7 the boot messages' text
term=$here/../ghostty-theme/.config/ghostty-theme/themes/oldschool-dark
colours=$(for i in $(seq 0 15); do
    case $i in 0) echo "$bg" ;; 7) echo "$fg" ;;
        *) sed -n "s/^palette = $i=#//p" "$term" ;; esac
done)
channel() { echo "$colours" | while read -r c; do printf '0x%s,' "$(echo "$c" | cut -c"$1")"; done | sed 's/,$//'; }
vt="vt.default_red=$(channel 1-2) vt.default_grn=$(channel 3-4) vt.default_blu=$(channel 5-6) fbcon=font:TER16x32"

sed -i -e 's/ *\(vt\.default_[a-z]*\|fbcon\)=[^ "]*//g' \
    -e "s|^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"|GRUB_CMDLINE_LINUX_DEFAULT=\"\1 $vt\"|" \
    -e '/^GRUB_THEME=/d' /etc/default/grub
echo "GRUB_THEME=\"$theme_dir/theme.txt\"" >> /etc/default/grub

grub-mkconfig -o /boot/grub/grub.cfg
echo "done: reboot to see it; ./uninstall-boot reverts"
