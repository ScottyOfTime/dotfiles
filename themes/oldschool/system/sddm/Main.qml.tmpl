// generated by install-sddm from the dark palette, edit the .tmpl
import QtQuick
import QtQuick.Window

// the lock screen (Lock.qml) as the login screen: the distro's logo, the
// user and a masked password, drawn in like a slow scan. Only one screen
// shows it: the one sddm gives keyboard focus (each screen is its own
// window with its own state), else the primary until one gets it. Sizes are physical pixels (SDDM runs unscaled), matching
// the lock's at 1.33x
Rectangle {
    id: root

    property bool focusSeen: false
    readonly property bool shown: Window.active
        || (!focusSeen && (typeof primaryScreen === "undefined" || primaryScreen))
    onShownChanged: if (Window.active) focusSeen = true
    // the last user to log in, else the first (a fresh install has none)
    readonly property string user: userModel.lastUser
        || (userModel.count > 0 ? userModel.data(userModel.index(0, 0), Qt.UserRole + 1) : "")
    property string password: ""
    property string status: ""
    property int attempts: 0
    property real drawn: 0
    property bool blinkOn: true

    width: 1280
    height: 800
    color: "#${bg}"

    function submit() {
        if (password === "" || status === "checking") return;
        status = "checking";
        sddm.login(user, password, sessionModel.lastIndex);
    }

    Connections {
        target: sddm
        function onLoginFailed() {
            root.password = "";
            root.attempts++;
            root.status = "failed";
        }
    }

    NumberAnimation on drawn { from: 0; to: 1; duration: 380 }
    Timer {
        interval: 530
        repeat: true
        running: root.shown && root.drawn >= 1
        onRunningChanged: root.blinkOn = true
        onTriggered: root.blinkOn = !root.blinkOn
    }

    Item {
        anchors.fill: parent
        focus: true
        // a plain item in sddm's view only gets keys once it asks
        Component.onCompleted: forceActiveFocus()
        Keys.onPressed: event => {
            if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                root.submit();
            } else if (event.key === Qt.Key_Backspace) {
                root.password = root.password.slice(0, -1);
            } else if (event.key === Qt.Key_Escape) {
                root.password = "";
            } else if (event.text !== "" && root.status !== "checking") {
                root.password += event.text;
                if (root.status === "failed") root.status = "";
            }
            event.accepted = true;
        }
    }

    Column {
        id: content
        visible: root.shown
        anchors.centerIn: parent
        spacing: 53

        Text {
            id: art
            anchors.horizontalCenter: parent.horizontalCenter
            font.family: "Terminess Nerd Font Mono"
            font.pixelSize: 32
            lineHeight: 1.0
            color: "#${fg}"
            textFormat: Text.PlainText
            text: ${logo}
        }

        Column {
            id: prompt
            width: art.width
            spacing: 8

            component Line: Text {
                font.family: "Terminess Nerd Font Mono"
                font.pixelSize: 20
                color: "#${fg}"
                textFormat: Text.PlainText
            }

            Line {
                x: Math.round((prompt.width - width) / 2)
                text: root.user
            }
            Item {
                width: prompt.width
                height: stars.height
                Line {
                    id: stars
                    x: Math.round((parent.width - width) / 2)
                    text: "*".repeat(root.password.length)
                }
                Line {
                    visible: root.blinkOn && root.status !== "checking"
                    x: root.password === "" ? Math.round((parent.width - width) / 2) : stars.x + stars.width
                    text: "█"
                }
            }
            Line {
                visible: root.status === "failed" && root.password === ""
                x: Math.round((prompt.width - width) / 2)
                color: "#${red}"
                text: `Login incorrect (${root.attempts})`
            }
        }
    }

    // the undrawn part: everything below the row being drawn, and that row
    // to the right of the beam
    Item {
        id: undrawn
        readonly property int row: 5
        readonly property real at: root.drawn * Math.ceil(content.height / row)
        readonly property int done: Math.floor(at)
        visible: content.visible && root.drawn < 1
        x: content.x
        y: content.y
        width: content.width
        height: content.height

        Rectangle {
            y: (undrawn.done + 1) * undrawn.row
            width: parent.width
            height: Math.max(0, parent.height - y)
            color: root.color
        }
        Rectangle {
            x: Math.round((undrawn.at - undrawn.done) * parent.width)
            y: undrawn.done * undrawn.row
            width: parent.width - x
            height: undrawn.row
            color: root.color
        }
    }
}
