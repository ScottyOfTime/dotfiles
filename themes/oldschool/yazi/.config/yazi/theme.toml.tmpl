# terminal colour names, so file types use each theme's terminal palette
[filetype]
rules = [
	{ mime = "**/image/*", fg = "yellow" },
	{ mime = "**/{audio,video}/*", fg = "magenta" },
	{ mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "cyan" },
	{ mime = "**/application/{pdf,doc,rtf}", fg = "green" },
	{ mime = "vfs/{absent,stale}", fg = "#${dim}" },
	{ url = "*", is = "orphan", fg = "#${red}" },
	{ url = "*", is = "dummy", fg = "#${red}" },
	{ url = "*/", is = "dummy", fg = "#${red}" },
	{ url = "*", is = "exec", fg = "#${fg}", bold = true },
	{ url = "*/", fg = "#${bright}", bold = true },
]

# square ends and no icons: the preset's rounded glyphs and icon colours
# aren't from this palette
[icon]
globs = []
dirs = []
files = []
exts = []
conds = []
