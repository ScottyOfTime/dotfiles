#version 300 es
// generated by darkman from ~/.config/palette/${mode}.env, edit the .tmpl
// a monochrome phosphor tube: every pixel, video included, becomes a
// brightness on the palette's own ramp
precision highp float;
// ints default to mediump (16 bits here), which drops the hex's red byte
precision highp int;

in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;

vec3 rgb(uint c) {
    return vec3(uvec3(c >> 16u, c >> 8u, c) & 255u) / 255.0;
}

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

float sampleLuma(vec2 at) {
    return luma(texture(tex, at).rgb);
}

float blur(vec2 px, float spread) {
    float sum = 0.0;
    float weight = 0.0;
    for (int x = -2; x <= 2; x++)
        for (int y = -2; y <= 2; y++) {
            float w = exp(-float(x * x + y * y) / 3.0);
            sum += sampleLuma(v_texcoord + vec2(x, y) * px * spread) * w;
            weight += w;
        }
    return sum / weight;
}

void main() {
    vec2 size = vec2(textureSize(tex, 0));
    vec2 px = 1.0 / size;

    vec3 bg = rgb(0x${bg}u);
    vec3 fg = rgb(0x${fg}u);
    bool dark = luma(bg) < luma(fg);
    vec3 lo = dark ? bg : fg;
    vec3 mid = dark ? fg : rgb(0x${dim}u);
    vec3 hi = dark ? rgb(0x${bright}u) : rgb(0x${panel}u);

    // light bleeds from bright pixels into darker neighbours only, so text
    // halos without washing out large light areas; soft falloffs, since a
    // ring of taps at a fixed distance outlines hover states
    float l = sampleLuma(v_texcoord);
    l += max(blur(px, 1.2) - l, 0.0) * 0.4;
    l += max(blur(px, 5.0) - l, 0.0) * 0.18;

    // stops at the palette colours' own brightness, so fg stays exactly fg
    float a = luma(lo), b = luma(mid), c = luma(hi);
    vec3 colour = l < b
        ? mix(lo, mid, smoothstep(a, b, l))
        : mix(mid, hi, smoothstep(b, c, l));

    float grain = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);
    colour *= 1.0 + (grain - 0.5) * 0.05;

    // the tube: a squarish vignette and rounded black corners
    vec2 centred = abs(v_texcoord * 2.0 - 1.0);
    float edge = length(pow(centred, vec2(6.0)));
    colour *= mix(1.0, 0.55, smoothstep(0.15, 1.0, edge));
    vec2 corner = max(abs(v_texcoord - 0.5) * size - (size * 0.5 - 28.0), 0.0);
    colour *= smoothstep(28.0, 26.0, length(corner));

    fragColor = vec4(colour, 1.0);
}
