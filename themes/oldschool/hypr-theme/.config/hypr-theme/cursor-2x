#!/usr/bin/env python3
"""cursor-2x <theme>_2x [rrggbb]: build ~/.local/share/icons/<theme>_2x
from an installed xcursor theme with every pixel repeated 2x and 3x, and
optionally tinted (white becomes the colour, black stays black). Themes that only ship
one small size stay tiny otherwise, since cursors aren't scaled up. Does
nothing if the copy already exists in that colour (or untinted)."""

import os
import struct
import sys
from pathlib import Path

name = sys.argv[1]
tint = sys.argv[2] if len(sys.argv) > 2 else ""
base = name.removesuffix("_2x")
target = Path.home() / ".local/share/icons" / name
# packaged in /usr/share/icons on Arch; elsewhere it's usually unpacked by
# hand into ~/.local/share/icons or ~/.icons
data_dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
roots = [Path.home() / ".local/share/icons", Path.home() / ".icons"]
roots += [Path(d) / "icons" for d in data_dirs.split(":") if d]
installed = next((r / base / "cursors" for r in roots if (r / base / "cursors").is_dir()),
                 Path("/usr/share/icons") / base / "cursors")
# untinted originals kept beside the copy, so it can be re-tinted even if
# the package is gone
kept = target / "original"
stamp = target / "tint"
if stamp.exists() and stamp.read_text() == tint:
    sys.exit()
tr, tg, tb = (int(tint[i:i + 2], 16) for i in (0, 2, 4)) if tint else (0, 0, 0)

IMAGE = 0xFFFD0002


def frames(data):
    _, _, _, count = struct.unpack_from("<4sIII", data)
    for i in range(count):
        kind, nominal, pos = struct.unpack_from("<3I", data, 16 + 12 * i)
        if kind == IMAGE:
            _, _, _, _, w, h, hx, hy, delay = struct.unpack_from("<9I", data, pos)
            yield nominal, w, h, hx, hy, delay, struct.unpack_from(f"<{w * h}I", data, pos + 36)


def smallest(data):
    images = list(frames(data))
    least = min(f[0] for f in images)
    return xcursor([f for f in images if f[0] == least])


def tinted(frame):
    # premultiplied argb: grey levels scale the tint, so edges keep their shade
    *head, pixels = frame
    out = []
    for p in pixels:
        a, r, g, b = p >> 24, (p >> 16) & 255, (p >> 8) & 255, p & 255
        level = (r + g + b) / 765
        out.append(a << 24 | round(tr * level) << 16 | round(tg * level) << 8 | round(tb * level))
    return (*head, out)


def scaled(frame, k):
    nominal, w, h, hx, hy, delay, pixels = frame
    rows = [pixels[y * w:(y + 1) * w] for y in range(h)]
    out = [p for row in rows for _ in range(k) for p in row for _ in range(k)]
    return nominal * k, w * k, h * k, hx * k, hy * k, delay, out


def xcursor(images):
    toc, chunks, pos = b"", b"", 16 + 12 * len(images)
    for nominal, w, h, hx, hy, delay, pixels in images:
        chunk = struct.pack("<9I", 36, IMAGE, nominal, 1, w, h, hx, hy, delay)
        chunk += struct.pack(f"<{len(pixels)}I", *pixels)
        toc += struct.pack("<3I", IMAGE, nominal, pos)
        chunks += chunk
        pos += len(chunk)
    return struct.pack("<4sIII", b"Xcur", 16, 0x10000, len(images)) + toc + chunks


if installed.is_dir():
    source = installed
elif kept.is_dir():
    source = kept
elif (target / "cursors").is_dir() and not stamp.exists():
    # an untinted copy from before originals were kept: its smallest images
    # are the originals
    source = target / "cursors"
else:
    sys.exit(f"cursor-2x: {base} isn't installed")

kept.mkdir(parents=True, exist_ok=True)
if source != kept:
    for path in source.iterdir():
        out = kept / path.name
        out.unlink(missing_ok=True)
        if path.is_symlink():
            out.symlink_to(path.readlink())
        else:
            out.write_bytes(smallest(path.read_bytes()))
    source = kept

(target / "cursors").mkdir(parents=True, exist_ok=True)
for path in source.iterdir():
    out = target / "cursors" / path.name
    if path.is_symlink():
        out.unlink(missing_ok=True)
        out.symlink_to(path.readlink())
        continue
    original = [tinted(f) if tint else f for f in frames(path.read_bytes())]
    out.write_bytes(xcursor(original + [scaled(f, k) for k in (2, 3) for f in original]))
(target / "index.theme").write_text(
    f"[Icon Theme]\nName={name}\nInherits={base}\n")
stamp.write_text(tint)
