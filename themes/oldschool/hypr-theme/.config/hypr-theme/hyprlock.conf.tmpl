# generated by darkman from ~/.config/palette/${mode}.env, edit the .tmpl
# hyprlang treats # as a comment, so colours in markup are written ##

general {
    hide_cursor = true
    ignore_empty_input = true
}

animations {
    enabled = true
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 3, linear
    animation = fadeOut, 1, 3, linear
    animation = inputFieldDots, 1, 2, linear
}

background {
    monitor =
    color = rgb(${bg})
}

input-field {
    monitor =
    size = 560, 54
    outline_thickness = 2
    rounding = 0
    outer_color = rgb(${line})
    inner_color = rgb(${panel})
    font_color = rgb(${bright})
    font_family = JetBrains Mono Bold
    check_color = rgb(${bright})
    fail_color = rgb(${red})
    capslock_color = rgb(${fg})
    placeholder_text = <span foreground='##${dim}'>password</span>
    check_text = <span foreground='##${bright}'>checking...</span>
    fail_text = <span foreground='##${red}'>wrong password ($ATTEMPTS)</span>
    dots_text_format = •
    dots_size = 0.4
    dots_spacing = 0.2
    dots_center = true
    fade_on_empty = false
    position = 0, 0
}
