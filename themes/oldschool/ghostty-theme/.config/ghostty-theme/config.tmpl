# generated by darkman from ~/.config/palette/${mode}.env, edit the .tmpl
# ghostty only takes absolute theme paths, and doesn't expand ~
theme = dark:${HOME}/.config/ghostty-theme/themes/oldschool-dark,light:${HOME}/.config/ghostty-theme/themes/oldschool-light
window-padding-x = 2
window-padding-y = 0
window-padding-balance = true
window-padding-color = extend
# no ligatures: every glyph stays one plain cell
font-feature = -calt
font-feature = -liga
cursor-style-blink = false
font-family = Terminess Nerd Font Mono
# terminus is drawn on a pixel grid: ghostty makes pt x 4/3 x the 1.33x scale,
# so 12.375pt is 22 physical px, a native terminus size; in-between sizes
# smear (15pt was ~27px)
font-size = 12.375
# no antialiasing: hard pixel edges
freetype-load-flags = hinting,force-autohint,monochrome
gtk-custom-css = tabs.css
