# generated by darkman from ~/.config/palette/${mode}.env, edit the .tmpl
# ghostty only takes absolute theme paths, and doesn't expand ~
theme = dark:${HOME}/.config/ghostty-theme/themes/oldschool-dark,light:${HOME}/.config/ghostty-theme/themes/oldschool-light
window-padding-x = 2
window-padding-y = 0
window-padding-balance = true
window-padding-color = extend
# no ligatures: every glyph stays one plain cell
font-feature = -calt
font-feature = -liga
cursor-style-blink = false
# terminus without its embedded bitmaps (hypr-theme/terminus-outline):
# ghostty draws a font's bitmaps when it has them, so it could never smooth
# like the shell does
font-family = Terminess Outline
font-size = 11.25
gtk-custom-css = tabs.css
