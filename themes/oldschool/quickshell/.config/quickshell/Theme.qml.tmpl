// generated by darkman from ~/.config/palette/${mode}.env, edit the .tmpl
pragma Singleton
import QtQuick
import Quickshell

Singleton {
    readonly property color bg: "#${bg}"
    readonly property color panel: "#${panel}"
    readonly property color surface: "#${surface}"
    readonly property color fg: "#${fg}"
    readonly property color dim: "#${dim}"
    readonly property color line: "#${line}"
    readonly property color bright: "#${bright}"
    readonly property color red: "#${red}"
    // text on a phosphor fill: selection is reverse video
    readonly property color onLit: bg
    readonly property string font: "Terminess Nerd Font Mono"
    // points, as qml pixel sizes are whole numbers: 11.25pt is 15px, 20
    // physical at 1.33x (21 and 22 looked too big)
    readonly property real fontPoints: 11.25
    readonly property int bar: 26

    // sizes that land on whole physical pixels for a window's scale (dpr):
    // at 1.25x a 26px bar is 32.5 pixels, and a 1px line on that half
    // pixel flickers in and out.
    // px: inside a window (lines, borders, rows); may be fractional
    function px(value, dpr) {
        const d = dpr || 1;
        return Math.max(1, Math.round(value * d)) / d;
    }
    // whole: window sizes and layer margins, which must also be whole
    // logical pixels (26.25 is cut to 26): the next size up that is both
    function whole(value, dpr) {
        const d = dpr || 1;
        for (let v = Math.ceil(value); v < value + 12; v++)
            if (Math.abs(v * d - Math.round(v * d)) < 0.01) return v;
        return Math.ceil(value);
    }
}
