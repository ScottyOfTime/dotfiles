tabbar,
tabbar .box {
  box-shadow: none;
  background-color: var(--ghostty-bg);
}

/* room for the tilt, which the bar would otherwise clip */
tabbar .box {
  padding: 8px 14px 12px;
}

tabbar tabbox {
  padding: 0;
  min-height: 0;
}

tabbar tabbox > tabboxchild {
  margin: 0 6px;
  border-radius: 2px;
}

tabbar tabbox > separator {
  margin: 0;
  min-width: 0;
  background: none;
}

tabbar tab {
  min-height: 26px;
  padding: 0 14px;
  border-radius: 2px;
  /* the hard shadow is an inner ink edge: tabboxchild clips box-shadow */
  border-style: solid;
  border-width: 0 3px 3px 0;
  border-color: #${ink};
  background-color: #${panel};
  color: alpha(#${fg}, 0.6);
  font-weight: bold;
  transform: rotate(-1.5deg);
  transition: transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1), background-color 120ms;
}

tabbar tabbox > tabboxchild:nth-child(even) tab {
  transform: rotate(1.5deg);
}

tabbar tabbox > tabboxchild:nth-child(3n) tab {
  transform: rotate(-2.5deg);
}

tabbar tab:hover {
  background-color: #${surface};
  color: #${fg};
  transform: rotate(0);
}

tabbar tab:selected,
tabbar tab:selected:hover,
tabbar tabbox > tabboxchild tab:selected {
  border-radius: 2px;
  background-color: #${accent};
  color: #${ink};
  border-width: 0 4px 4px 0;
  transform: rotate(0) scale(1.04);
}

tabbar tab .tab-title {
  margin: 0;
}

tabbar tab button.tab-close-button {
  opacity: 0;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  -gtk-icon-size: 0;
}
